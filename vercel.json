{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": [
    "fra1"
  ],
  "functions": {
    "index.py": {
      "maxDuration": 30,
      "excludeFiles": "{tests/**,*.db}"
    }
  },
  "crons": [
    {
      "path": "/api/morning",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/evening",
      "schedule": "0 20 * * *"
    }
  ]
}
